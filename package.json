{
  "name": "aether-os",
  "version": "0.1.0-alpha.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "description": "A single-target Linux workstation OS: Rust compositor, zero-copy IPC, capability-isolated agents.",
  "engines": {
    "node": ">=26"
  },
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun run --cwd apps/web dev",
    "dev:docs": "bun run --cwd apps/docs start",
    "build": "bun run build:web && bun run build:docs && bun run scripts/assemble.ts",
    "build:web": "bun run --cwd apps/web build",
    "build:docs": "bun run --cwd apps/docs build",
    "preview": "bun run --cwd apps/web preview",
    "test": "bun test packages tests",
    "test:unit": "bun test packages tests",
    "test:e2e": "playwright test",
    "test:all": "bun run test:unit && bun run test:e2e",
    "test:design": "bun scripts/design-parity.ts",
    "parity": "bash scripts/screenshots/os-parity.sh",
    "parity:compare": "node scripts/screenshots/os-parity.mjs --compare",
    "screenshots": "bash scripts/capture-screenshots.sh",
    "screenshots:web": "bash scripts/capture-web-screenshots.sh",
    "screenshots:shell": "bash scripts/capture-shell-screenshots.sh",
    "screenshots:publish": "bun run scripts/publish-screenshots.ts",
    "typecheck": "tsc --noEmit",
    "bench": "bun run packages/bench/src/cli.ts",
    "bench:check": "bun run packages/bench/src/cli.ts --check",
    "verify:ci": "bash scripts/ci-local.sh",
    "lint:workflows": "bash scripts/lint-workflows.sh",
    "os:test": "cargo test --manifest-path os/compositor/Cargo.toml",
    "verify": "bun run typecheck && bun run test:unit && bun run test:design && bun run build",
    "parity:design": "node scripts/screenshots/design-docs.mjs",
    "parity:design:check": "node scripts/screenshots/design-docs.mjs --check",
    "parity:scene": "node scripts/screenshots/scene-diff.mjs",
    "parity:state": "node scripts/screenshots/design-state.mjs",
    "parity:state:diff": "node scripts/screenshots/design-state.mjs --diff-only",
    "parity:apps": "node scripts/screenshots/app-parity.mjs",
    "parity:apps:report": "node scripts/screenshots/app-parity.mjs --report-only"
  },
  "devDependencies": {
    "@google/design.md": "^0.4.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "^1.56.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "happy-dom": "^21.0.4",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5.9.0"
  }
}
