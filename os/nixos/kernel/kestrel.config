# Aether kernel config fragment — Kaby Lake / i7-7700K
#
# This is appended to nixpkgs' defconfig by os/nixos/kernel.nix. Values here
# are the ones the architecture actually depends on: isolation, IPC, audio,
# storage, and a 1 kHz tick for frame pacing. Everything else is left to the
# defconfig and can be trimmed further with localmodconfig on the real machine.

# --- identity & scheduling -------------------------------------------------
CONFIG_LOCALVERSION="-aether"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_MCORE2=y

# --- isolation primitives (the reason this OS exists) ----------------------
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_LSM="landlock,yama,bpf"
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_MEMCG=y
CONFIG_MEMFD_CREATE=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_NAMESPACES=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_IO_URING=y

# --- virtualization for the hostile tier -----------------------------------
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_VFIO=y
CONFIG_VFIO_PCI=y
CONFIG_VFIO_IOMMU_TYPE1=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y

# --- graphics: HD 630 / i915 ------------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_I915_USERPTR=y
CONFIG_DRM_I915_GVT=n

# --- audio: PipeWire needs ALSA + USB + Bluetooth ---------------------------
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_USB_AUDIO=y
CONFIG_BT=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y

# --- storage -----------------------------------------------------------------
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_XFS_FS=y
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y

# --- hardening ----------------------------------------------------------------
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_PAGE_TABLE_ISOLATION=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_X86_SMAP=y
CONFIG_X86_UMIP=y

# --- remove what this machine does not need ----------------------------------
CONFIG_DEBUG_INFO=n
CONFIG_KALLSYMS_ALL=n
CONFIG_ZSWAP=n
CONFIG_ZRAM=n
CONFIG_HIBERNATION=n
CONFIG_WATCHDOG=n
CONFIG_SOFTLOCKUP_DETECTOR=n
CONFIG_HARDLOCKUP_DETECTOR=n
CONFIG_MODULE_SIG_FORCE=n
